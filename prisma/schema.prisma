generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  description          String?
  status               String        @default("draft")
  devUrl               String?
  productionUrl        String?
  repoUrl              String?
  targetDevDomain      String?
  preferredStack       String?
  repositoryProvider   String?
  repositoryFullName   String?
  repositoryUrl        String?
  repositoryDefaultBranch String?
  repositoryVisibility String?
  repositoryDescription String?
  repositoryLastCommitSha String?
  repositoryLastCommitMessage String?
  repositoryLastCommitUrl String?
  repositoryLastCommitAt DateTime?
  repositoryLastCheckedAt DateTime?
  coolifyApplicationId String?
  coolifyProjectId     String?
  notes                String?
  archivedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  instructions         Instruction[]
  agentRuns            AgentRun[]
  activityLogs         ActivityLog[]
  environments         Environment[]
  tasks                Task[]
}

model Instruction {
  id        String     @id @default(cuid())
  projectId String
  content   String
  source    String     @default("manual")
  status    String     @default("pending")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]
}

model AgentRun {
  id            String       @id @default(cuid())
  projectId     String
  instructionId String?
  agentName     String?
  model         String?
  status        String       @default("queued")
  input         String?
  output        String?
  costEstimate  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instruction   Instruction? @relation(fields: [instructionId], references: [id], onDelete: SetNull)
  tasks         Task[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String   @default("dev")
  url       String?
  provider  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id               String    @id @default(cuid())
  projectId        String
  sourceAgentRunId String?
  title            String
  description      String?
  type             String    @default("backend")
  priority         String    @default("medium")
  status           String    @default("todo")
  sortOrder        Int       @default(0)
  assignedAgent    String?
  notes            String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  githubIssueNumber        Int?
  githubIssueUrl           String?
  githubIssueState         String?
  githubIssueTitle         String?
  githubIssueCreatedAt     DateTime?
  githubIssueUpdatedAt     DateTime?
  githubIssueLastCheckedAt DateTime?
  githubBranchName         String?
  githubBranchUrl          String?
  githubBaseBranch         String?
  githubBaseSha            String?
  githubBranchCreatedAt    DateTime?
  githubBranchLastCheckedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAgentRun   AgentRun? @relation(fields: [sourceAgentRunId], references: [id], onDelete: SetNull)
}
