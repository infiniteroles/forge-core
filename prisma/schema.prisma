generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  description          String?
  status               String        @default("draft")
  devUrl               String?
  productionUrl        String?
  repoUrl              String?
  targetDevDomain      String?
  preferredStack       String?
  repositoryProvider   String?
  repositoryFullName   String?
  repositoryUrl        String?
  repositoryDefaultBranch String?
  repositoryVisibility String?
  repositoryDescription String?
  repositoryLastCommitSha String?
  repositoryLastCommitMessage String?
  repositoryLastCommitUrl String?
  repositoryLastCommitAt DateTime?
  repositoryLastCheckedAt DateTime?
  coolifyApplicationId String?
  coolifyProjectId     String?
  publishedAppUuid     String?
  publishedAt          DateTime?
  notes                String?
  archivedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  instructions         Instruction[]
  agentRuns            AgentRun[]
  activityLogs         ActivityLog[]
  environments         Environment[]
  tasks                Task[]
  workSessions         WorkSession[]
  sessionChecks        SessionCheck[]
  previewDeployments   PreviewDeployment[]
  productionReadinessReviews ProductionReadinessReview[]
  productionPromotions ProductionPromotion[]
  composerSessions         ComposerSession[]
}

model WorkSession {
  id                   String         @id @default(cuid())
  projectId            String
  taskId               String?
  parentWorkSessionId  String?
  requestedChanges     String?
  iterationNumber      Int            @default(1)
  status               String         @default("queued")
  mode                 String         @default("dev")
  objective            String
  summary              String?
  currentStage         String?
  result               Json?
  error                String?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                 Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  parentWorkSession    WorkSession?   @relation("WorkSessionIterations", fields: [parentWorkSessionId], references: [id], onDelete: SetNull)
  childrenWorkSessions WorkSession[]  @relation("WorkSessionIterations")
  agentRuns            AgentRun[]
  sessionChecks        SessionCheck[]
  previewDeployments   PreviewDeployment[]
  productionReadinessReviews ProductionReadinessReview[]
  productionPromotions ProductionPromotion[]
}

model Instruction {
  id        String     @id @default(cuid())
  projectId String
  content   String
  source    String     @default("manual")
  status    String     @default("pending")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]
}

model AgentRun {
  id                String       @id @default(cuid())
  projectId         String
  instructionId     String?
  taskId            String?
  workSessionId     String?
  agentName         String?
  model             String?
  status            String       @default("queued")
  input             String?
  output            String?
  costEstimate      String?
  // Fase 4.5 — LLM usage metrics (null when provider returns no usage).
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  estimatedCostUsd  Float?
  provider          String?
  metadata          Json?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime     @default(now())
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instruction       Instruction? @relation(fields: [instructionId], references: [id], onDelete: SetNull)
  task              Task?        @relation("TaskRuns", fields: [taskId], references: [id], onDelete: SetNull)
  workSession       WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  tasks             Task[]       @relation("SourceAgentRuns")
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String   @default("dev")
  url       String?
  provider  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id               String    @id @default(cuid())
  projectId        String
  sourceAgentRunId String?
  title            String
  description      String?
  type             String    @default("backend")
  priority         String    @default("medium")
  status           String    @default("todo")
  sortOrder        Int       @default(0)
  assignedAgent    String?
  notes            String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  githubIssueNumber        Int?
  githubIssueUrl           String?
  githubIssueState         String?
  githubIssueTitle         String?
  githubIssueCreatedAt     DateTime?
  githubIssueUpdatedAt     DateTime?
  githubIssueLastCheckedAt DateTime?
  githubBranchName         String?
  githubBranchUrl          String?
  githubBaseBranch         String?
  githubBaseSha            String?
  githubBranchCreatedAt    DateTime?
  githubBranchLastCheckedAt DateTime?
  githubPlanPath           String?
  githubPlanCommitSha      String?
  githubPlanCommitUrl      String?
  githubPlanCommitMessage  String?
  githubPlanCommittedAt    DateTime?
  githubPlanLastCheckedAt  DateTime?
  githubPrNumber           Int?
  githubPrUrl              String?
  githubPrState            String?
  githubPrTitle            String?
  githubPrDraft            Boolean?
  githubPrBaseBranch       String?
  githubPrHeadBranch       String?
  githubPrCreatedAt        DateTime?
  githubPrUpdatedAt        DateTime?
  githubPrMergedAt         DateTime?
  githubPrLastCheckedAt    DateTime?
  githubBuilderCommitSha        String?
  githubBuilderCommitUrl        String?
  githubBuilderCommitMessage    String?
  githubBuilderCommittedAt      DateTime?
  githubBuilderLastCheckedAt    DateTime?
  builderLastRunId              String?
  builderLastStatus             String?
  builderLastSummary            String?
  githubPrReviewRunId             String?
  githubPrReviewStatus            String?
  githubPrReviewSummary           String?
  githubPrReviewRecommendation    String?
  githubPrReviewRiskLevel         String?
  githubPrReviewReadyForReview    Boolean?
  githubPrReviewLastCheckedAt     DateTime?
  githubPrMarkedReadyAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAgentRun   AgentRun? @relation("SourceAgentRuns", fields: [sourceAgentRunId], references: [id], onDelete: SetNull)
  agentRuns        AgentRun[] @relation("TaskRuns")
  workSessions     WorkSession[]
  sessionChecks    SessionCheck[]
  previewDeployments PreviewDeployment[]
  productionReadinessReviews ProductionReadinessReview[]
  productionPromotions ProductionPromotion[]
}

model PreviewDeployment {
  id                     String    @id @default(cuid())
  projectId              String
  taskId                 String?
  workSessionId          String?
  provider               String    @default("coolify")
  status                 String    @default("not_configured")
  previewUrl             String?
  domain                 String?
  branchName             String?
  repositoryFullName     String?
  pullRequestNumber      Int?
  coolifyApplicationUuid String?
  coolifyDeploymentUuid  String?
  coolifyProjectUuid     String?
  coolifyServerUuid      String?
  commitSha              String?
  lastDeploymentStatus   String?
  lastDeploymentLogUrl   String?
  error                  String?
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  requestedAt            DateTime?
  deployedAt             DateTime?
  lastCheckedAt          DateTime?
  stoppedAt              DateTime?
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                   Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workSession            WorkSession?  @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  productionReadinessReviews ProductionReadinessReview[]
  productionPromotions ProductionPromotion[]
}

model SessionCheck {
  id            String     @id @default(cuid())
  workSessionId String
  projectId     String
  taskId        String?
  name          String
  command       String
  status        String     @default("queued")
  exitCode      Int?
  summary       String?
  stdoutTail    String?
  stderrTail    String?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model ProductionReadinessReview {
  id                  String    @id @default(cuid())
  projectId           String
  taskId              String?
  workSessionId       String?
  previewDeploymentId String?
  status              String    @default("draft")
  recommendation      String?
  riskLevel           String?
  summary             String?
  blockingReasons     Json?
  diagnostics         Json?
  checksSummary       Json?
  previewSummary      Json?
  prSummary           Json?
  filesSummary        Json?
  humanNotes          String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workSession         WorkSession?       @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  previewDeployment   PreviewDeployment? @relation(fields: [previewDeploymentId], references: [id], onDelete: SetNull)
  productionPromotions ProductionPromotion[]
}

model ProductionPromotion {
  id                          String    @id @default(cuid())
  projectId                   String
  taskId                      String?
  workSessionId               String?
  productionReadinessReviewId String?
  previewDeploymentId         String?
  status                      String    @default("draft")
  strategy                    String    @default("github_pr_merge")
  summary                     String?
  error                       String?
  prNumber                    Int?
  prUrl                       String?
  branchName                  String?
  baseBranch                  String?
  mergeCommitSha              String?
  mergeMethod                 String?
  jobRunId                    String?  @unique
  preflightSummary            Json?
  deploymentSummary           Json?
  verificationSummary         Json?
  metadata                    Json?
  requestedBy                 String?
  requestedAt                 DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  failedAt                    DateTime?
  cancelledAt                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  project                     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                        Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workSession                 WorkSession?               @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  productionReadinessReview   ProductionReadinessReview? @relation(fields: [productionReadinessReviewId], references: [id], onDelete: SetNull)
  previewDeployment           PreviewDeployment?         @relation(fields: [previewDeploymentId], references: [id], onDelete: SetNull)
  jobRun                      JobRun?                    @relation(fields: [jobRunId], references: [id], onDelete: SetNull)
}

model JobRun {
  id            String   @id @default(cuid())
  type          String
  status        String   @default("queued")
  resourceType  String?
  resourceId    String?
  projectId     String?
  taskId        String?
  workSessionId String?

  currentStage    String?
  progressPercent Int?
  summary         String?
  error           String?

  input    Json?
  result   Json?
  metadata Json?

  lockedAt        DateTime?
  lockedBy        String?
  startedAt       DateTime?
  finishedAt      DateTime?
  failedAt        DateTime?
  cancelledAt     DateTime?
  lastHeartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionPromotion ProductionPromotion?
}

model WorkerState {
  id          String   @id @default("forge-worker")
  workerId    String?
  enabled     Boolean  @default(true)
  heartbeatAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ComposerSession {
  id        String   @id @default(cuid())
  status    String   @default("discovering") // discovering|proposal|planning|building|preview|done|blocked
  messages  Json     @default("[]")
  spec      Json?
  proposal  Json?
  plan      Json?
  projectId String?
  logoUrl   String?
  stylePref String?
  palette   Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}
