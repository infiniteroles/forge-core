DATABASE_URL="postgresql://user:password@host:5432/forge_core"
AUTH_SECRET="change-me"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"
NEXT_PUBLIC_APP_URL="https://forge-app.dev.core01.io"

# LLM gateway (DeepSeek, OpenAI-compatible). Leave DEEPSEEK_API_KEY empty to disable.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"
LLM_REQUEST_TIMEOUT_MS="90000"
# Reintentos automáticos ante respuestas vacías/timeout del proveedor LLM
# (DeepSeek a veces devuelve "empty_response" de forma intermitente).
LLM_MAX_RETRIES="5"
LLM_RETRY_DELAY_MS="1200"

# GitHub integration. GITHUB_TOKEN is optional for reading public repository
# metadata, but REQUIRED to create issues, branches, plan commits and draft PRs.
GITHUB_TOKEN=""
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_DEFAULT_OWNER="infiniteroles"

# DEV Preview from Work Session. Keep COOLIFY_API_TOKEN empty to disable the
# Coolify API integration (previews stay "not configured"). Never commit a real
# token; it is never shown in the UI, logs or ActivityLog.
COOLIFY_BASE_URL="https://forge.core01.io"
COOLIFY_API_TOKEN=""
COOLIFY_SERVER_UUID=""
COOLIFY_PROJECT_UUID=""
# GitHub App source uuid (from Coolify → Sources) — required to create DEV
# previews of PRIVATE repositories (POST /applications/github). Leave empty if
# you only preview public repos.
COOLIFY_GITHUB_APP_UUID=""
COOLIFY_ENVIRONMENT_NAME="dev"
PREVIEW_DOMAIN_SUFFIX=".dev.core01.io"
# PREVIEW_RUNNER_MODE: disabled | manual | coolify_api (default: disabled)
PREVIEW_RUNNER_MODE="disabled"
# Coolify preview app defaults (used when PREVIEW_RUNNER_MODE=coolify_api)
PREVIEW_DEFAULT_PORT="3000"
PREVIEW_BUILD_PACK="dockerfile"
PREVIEW_APP_NAME_PREFIX="forge-preview"
PREVIEW_DEPLOY_TIMEOUT_MS="300000"

# Preview Runtime Environment (Fase 3.7C)
# Controls which env vars are injected into Coolify preview applications so
# they can boot without copying all of Forge's secrets.
# PREVIEW_ENV_MODE: disabled | minimal | shared_dev (default: disabled)
#   disabled   = do not inject any env vars
#   minimal    = inject only generated, non-secret values (APP_URL,
#                NEXT_PUBLIC_APP_URL, NODE_ENV)
#   shared_dev = copy only the allowlist below from Forge's env (never the
#                denylist), plus the generated values
PREVIEW_ENV_MODE="disabled"
PREVIEW_ENV_ALLOWED_KEYS="DATABASE_URL,AUTH_SECRET,APP_URL,NEXT_PUBLIC_APP_URL,NODE_ENV"
PREVIEW_ENV_NODE_ENV="production"
PREVIEW_ENV_APP_URL_TEMPLATE="https://{domain}"

# Production Promotion (Fase 3.9 — Controlled Production Promotion)
# Base URL of the production environment used for post-merge health checks.
PRODUCTION_BASE_URL="https://forge-app.dev.core01.io"
# PRODUCTION_PROMOTION_MODE: github_merge | disabled (default: github_merge)
PRODUCTION_PROMOTION_MODE="github_merge"
# Max time to wait (ms) for the production deploy to pick up the merge.
# Coolify builds typically take ~5-10 min, so 600000 (10 min) avoids false
# timeouts while the async job waits for the real deploy (Fase 4.2B).
PRODUCTION_DEPLOY_WAIT_MS="600000"
# How often (ms) to poll the production endpoint while waiting.
PRODUCTION_DEPLOY_POLL_INTERVAL_MS="10000"
# PRODUCTION_DEPLOY_MODE: manual_wait | coolify_api (default: manual_wait)
#   manual_wait: do NOT call Coolify; a human triggers the production deploy
#   (legacy Fase 4.1 behaviour). The job waits/polls the endpoints.
#   coolify_api: the promotion job resolves the production app and triggers
#   its deployment via the Coolify API (POST /applications/{uuid}/start).
PRODUCTION_DEPLOY_MODE="manual_wait"
# Coolify application UUID of the production app. If empty, Forge tries to
# discover it by matching the production domain against Coolify apps.
PRODUCTION_COOLIFY_APPLICATION_UUID=""
# Max time (ms) for the Coolify deploy-trigger call itself.
PRODUCTION_DEPLOY_TRIGGER_TIMEOUT_MS="30000"

# --- Fase 4.0: Async jobs ---
# ASYNC_JOBS_MODE: inline | disabled (default: inline). Inline runs promotion
# jobs as background continuations on the same Node process (no queue yet).
ASYNC_JOBS_MODE="inline"
# A running/waiting job without a heartbeat older than this (ms) is stale.
ASYNC_JOBS_STALE_MS="120000"

# --- Fase 4.3: Detached Job Runner ---
# The web enqueues JobRuns; a separate forge-worker process (npm run worker)
# polls the queue and runs them, so long promotions survive a redeploy of the
# web container. No Redis yet: Postgres polling + conditional-update locks.
#   web:    JOB_WORKER_ENABLED=false  (enqueue only, never runs inline)
#   worker: JOB_WORKER_ENABLED=true   (processes the queue)
JOB_WORKER_ENABLED="false"
JOB_WORKER_ID="forge-worker"
JOB_WORKER_POLL_INTERVAL_MS="5000"
JOB_WORKER_LOCK_TIMEOUT_MS="120000"
JOB_WORKER_HEARTBEAT_MS="10000"
JOB_WORKER_MAX_CONCURRENT_JOBS="1"
JOB_WORKER_TYPES="production_promotion"

# --- Fase 4.5: LLM cost & context efficiency ---
# Track per-call LLM usage (tokens + estimated cost) on AgentRun. Cost is only
# estimated when prices are configured; otherwise it stays n/a (nothing is
# invented). Never blocks anything.
LLM_COST_TRACKING_ENABLED="true"
# USD per 1M tokens (DeepSeek-style). Leave empty to keep cost as n/a.
LLM_DEEPSEEK_INPUT_COST_PER_1M=""
LLM_DEEPSEEK_OUTPUT_COST_PER_1M=""
# Context budget for LLM prompts (conservative defaults).
LLM_CONTEXT_MAX_FILES="8"
LLM_CONTEXT_MAX_FILE_BYTES="20000"
LLM_CONTEXT_MAX_TOTAL_BYTES="80000"
LLM_CONTEXT_INCLUDE_ACTIVITY_LIMIT="20"
# Per-work-session LLM budget (non-aggressive; empty = no limit).
LLM_MAX_CALLS_PER_WORK_SESSION=""
LLM_MAX_CALLS_PER_ITERATION=""
LLM_WARN_AFTER_CALLS=""
